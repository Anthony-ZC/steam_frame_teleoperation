          "path": "/user/hand/right/input/menu",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/teleop/in/menu_click"
            },
            "touch": {
              "output": "/actions/teleop/in/menu_touch"
            }
          }
        },
        {
          "path": "/user/hand/right/input/system",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/teleop/in/system_click"
            },
            "touch": {
              "output": "/actions/teleop/in/system_touch"
            }
          }
        },
        {
          "path": "/user/hand/right/input/bumper",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/teleop/in/bumper_click"
            },
            "touch": {
              "output": "/actions/teleop/in/bumper_touch"
            }
          }
        },
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "click": {
              "output": "/actions/teleop/in/thumbstick_click"
            },
            "touch": {
              "output": "/actions/teleop/in/thumbstick_touch"
            },
            "position": {
