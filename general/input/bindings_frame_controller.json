          "path": "/user/hand/right/input/thumbrest",
          "mode": "button",
          "inputs": {
            "touch": {
              "output": "/actions/teleop/in/thumbrest_touch"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/teleop/in/trigger_click"
