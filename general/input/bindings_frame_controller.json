            "touch": {
              "output": "/actions/teleop/in/b_touch"
            }
          }
        },
        {
          "path": "/user/hand/right/input/x",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/teleop/in/x_click"
            },
            "touch": {
              "output": "/actions/teleop/in/x_touch"
            }
          }
        },
        {
          "path": "/user/hand/right/input/y",
          "mode": "button",
          "inputs": {
            "click": {
