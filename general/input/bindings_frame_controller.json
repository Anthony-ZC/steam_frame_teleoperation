        {
          "path": "/user/hand/left/input/thumbrest",
          "mode": "button",
          "inputs": {
            "touch": {
              "output": "/actions/teleop/in/thumbrest_touch"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/teleop/in/trigger_click"
            },
            "touch": {
              "output": "/actions/teleop/in/trigger_touch"
            },
            "pull": {
              "output": "/actions/teleop/in/trigger"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/teleop/in/grip_click"
            },
            "touch": {
              "output": "/actions/teleop/in/grip_touch"
            },
            "pull": {
              "output": "/actions/teleop/in/grip"
            }
