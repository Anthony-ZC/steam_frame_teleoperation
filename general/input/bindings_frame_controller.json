{
  "controller_type": "frame_controller",
  "name": "Teleop probe (frame_controller)",
  "bindings": {
    "/actions/teleop": {
      "sources": [
        {
          "path": "/user/hand/left/input/dpad_down",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/teleop/in/a_click"
            },
            "touch": {
              "output": "/actions/teleop/in/a_touch"
            }
          }
        },
        {
          "path": "/user/hand/left/input/dpad_right",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/teleop/in/b_click"
            },
            "touch": {
              "output": "/actions/teleop/in/b_touch"
            }
          }
        },
        {
          "path": "/user/hand/left/input/dpad_left",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/teleop/in/x_click"
            },
            "touch": {
              "output": "/actions/teleop/in/x_touch"
            }
          }
        },
        {
          "path": "/user/hand/left/input/dpad_up",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/teleop/in/y_click"
            },
            "touch": {
              "output": "/actions/teleop/in/y_touch"
            }
          }
        },
        {
          "path": "/user/hand/left/input/view",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/teleop/in/menu_click"
            },
            "touch": {
              "output": "/actions/teleop/in/menu_touch"
            }
          }
        },
        {
          "path": "/user/hand/left/input/system",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/teleop/in/system_click"
            },
            "touch": {
              "output": "/actions/teleop/in/system_touch"
            }
          }
        },
        {
          "path": "/user/hand/left/input/bumper",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/teleop/in/bumper_click"
            },
            "touch": {
              "output": "/actions/teleop/in/bumper_touch"
